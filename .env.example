# ══════════════════════════════════════════════════════════════════════
#  Oblimint — development environment (copy to .env at the repo root)
#  In production nothing is needed: the setup wizard writes
#  ${OBLIMINT_DATA_DIR}/config/oblimint.json (database URL + session secret).
# ══════════════════════════════════════════════════════════════════════

# Only NODE_ENV=development accepts the built-in development session secret
# and weak secrets.
NODE_ENV=development

# Database. Set → normal mode (setup wizard skipped). Unset AND no config file
# → SETUP MODE (no database; only /health, /api/setup/* and the client).
# docker compose -f docker-compose.dev.yml up -d  starts this PostgreSQL:
DATABASE_URL=postgres://oblimint:oblimint-dev@localhost:5433/oblimint

# 32+ random characters outside development (openssl rand -hex 32).
SESSION_SECRET=

# HTTP port in development (Vite proxies /api, /auth, /socket.io, /health to it).
# In the container: PORT=8443 with PANEL_TLS=selfsigned (HTTPS, self-signed
# certificate kept in <data dir>/panel/tls).
PORT=3025
# PANEL_TLS=selfsigned

# Data directory (config/, panel/postgres, panel/tls…). Same path on the host
# and in the container (-v /srv/oblimint:/srv/oblimint).
# OBLIMINT_DATA_DIR=/srv/oblimint
# Docker Engine socket used by the setup wizard (host checks, deployments).
# DOCKER_SOCKET=/var/run/docker.sock

# CORS origin of the Vite dev server.
CLIENT_ORIGIN=http://localhost:5174

# Public URL of the panel (trusted origin of the Obligate SSO redirect_uri).
# APP_URL=https://panel.example.com

# Reverse proxy in front of the panel: number of hops Express trusts, and the
# proxies whose X-Forwarded-For is honoured for client IPs (audit log).
# TRUST_PROXY_HOPS=0
# TRUSTED_PROXIES=loopback
# TRUSTED_PROXY_HOPS=1

# Break-glass administrator, created at start while no administrator exists
# (normal mode only; the setup wizard creates its own). Empty password →
# generated and printed ONCE in the logs. Outside development: 12+ characters.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# Optional secret Obligate presents on its calls to this panel (Bearer),
# instead of the API key.
# OBLIGATE_INBOUND_SECRET=

# How long the server waits for PostgreSQL at boot, in milliseconds.
# DB_WAIT_TIMEOUT_MS=120000
