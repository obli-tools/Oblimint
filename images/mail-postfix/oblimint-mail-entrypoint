#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# oblimint-mail entrypoint (tini is PID 1): prepares the runtime directories,
# generates a self-signed fallback certificate (used until the panel copies
# real ones into mail/certs), compiles the configuration generated by the
# panel (oblimint-mail-ctl compile), then runs Dovecot and Postfix in the
# foreground and stops the container as soon as one of them dies (Docker's
# restart policy brings both back).
# ─────────────────────────────────────────────────────────────────────────────
set -eu

RUN=/run/oblimint-mail
SRC=/etc/oblimint/mail
STATE=/var/lib/oblimint-mail
WAIT_CONFIG_SEC=${OBLIMINT_MAIL_WAIT_CONFIG_SEC:-120}

log() {
	printf '%s oblimint-mail: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

die() {
	log "$*"
	exit 1
}

mkdir -p "$RUN/selfsigned" /run/dovecot
chmod 0755 "$RUN"
chmod 0700 "$RUN/selfsigned"

if [ ! -s "$RUN/selfsigned/privkey.pem" ]; then
	openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=$(hostname)" \
		-keyout "$RUN/selfsigned/privkey.pem" -out "$RUN/selfsigned/fullchain.pem" >/dev/null 2>&1 \
		|| die 'could not generate the self-signed fallback certificate'
	chmod 0600 "$RUN/selfsigned/privkey.pem"
	chmod 0644 "$RUN/selfsigned/fullchain.pem"
fi

# data volume: Maildirs (vmail), Postfix data_directory, Dovecot state, ctl outputs
[ -d /var/vmail ] || die '/var/vmail is not mounted'
chown vmail:vmail /var/vmail
chmod 0700 /var/vmail
mkdir -p "$STATE/postfix" "$STATE/dovecot" "$STATE/ctl"
chown root:root "$STATE" "$STATE/dovecot" "$STATE/ctl"
chmod 0755 "$STATE"
chmod 0700 "$STATE/ctl"
chown postfix:postfix "$STATE/postfix"
chmod 0700 "$STATE/postfix"

i=0
until [ -s "$SRC/postfix/main.cf" ] && [ -s "$SRC/dovecot/dovecot.conf" ]; do
	i=$((i + 2))
	[ "$i" -le "$WAIT_CONFIG_SEC" ] || die "no generated configuration in $SRC after ${WAIT_CONFIG_SEC} s"
	[ "$i" -eq 2 ] && log "waiting for the configuration generated by the panel in $SRC"
	sleep 2
done

/usr/local/bin/oblimint-mail-ctl compile

dovecot -F &
dpid=$!
postfix start-fg &
ppid=$!

term() {
	log 'stopping'
	postfix stop >/dev/null 2>&1 || true
	kill -TERM "$dpid" 2>/dev/null || true
	wait "$dpid" 2>/dev/null || true
	wait "$ppid" 2>/dev/null || true
	exit 0
}
trap term TERM INT

log "Dovecot (pid $dpid) and Postfix (pid $ppid) started"
while kill -0 "$dpid" 2>/dev/null && kill -0 "$ppid" 2>/dev/null; do
	sleep 5 &
	wait $! || true
done
log 'Postfix or Dovecot exited: stopping the container'
postfix stop >/dev/null 2>&1 || true
kill -TERM "$dpid" 2>/dev/null || true
exit 1
