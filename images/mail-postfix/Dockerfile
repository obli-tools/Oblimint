# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# meejay/oblimint-mail-postfix — mail engine 'postfix-dovecot' (module
# engine-postfix, P4): Postfix (MX 25, submission 587 / 465, site relay intake
# 10025) + Dovecot (IMAP 143 / 993, POP3 110 / 995, ManageSieve 4190, LMTP,
# quota + quota-status, Pigeonhole Sieve) in one container; Rspamd and Redis
# run next to it (images/mail-rspamd, redis:7.4-alpine).
#
# Build context: the images/ directory (see images/build.sh):
#   docker build -f mail-postfix/Dockerfile -t meejay/oblimint-mail-postfix:latest .
#
# Base: Alpine 3.21 — same family as the other platform images (scanner,
# filesrv…), small, Postfix 3.9 with lmdb maps (Berkeley DB is gone from
# Alpine), Dovecot 2.3.21 + Pigeonhole 0.5.21 (the 2.3 configuration syntax
# the panel renders; 2.4 changed it), musl crypt() verifies every scheme the
# panel imports ($1$ MD5-CRYPT, $5$ / $6$ SHA-CRYPT, $2y$ BLF-CRYPT; SSHA* are
# Dovecot-internal). Pin the digest on the build host (the Linux test host):
#   docker buildx imagetools inspect alpine:3.21
#
# Runtime (set by the panel — server/src/services/mail/engines/postfixDovecot/spec.ts):
#   started as root (Postfix's and Dovecot's masters drop every service to
#   its own user), CapDrop ALL + CHOWN DAC_OVERRIDE FOWNER KILL
#   NET_BIND_SERVICE SETGID SETUID SYS_CHROOT, no-new-privileges, read-only
#   root, tmpfs /run (compiled configuration generations, sockets, self-signed
#   fallback) and /tmp; MAIL network only; public ports 25 465 587 143 993 110
#   995 4190 published, 10025 never.
#   Mounts: /var/vmail            ← mail/data/postfix-dovecot/vmail  (rw, vmail 5000:5000)
#           /var/spool/postfix    ← mail/data/postfix-dovecot/spool  (rw, Postfix queue)
#           /var/lib/oblimint-mail← mail/data/postfix-dovecot/state  (rw)
#           /etc/oblimint/mail    ← mail/config/postfix-dovecot      (RO, generated by the panel)
#           /etc/oblimint/mail-certs ← mail/certs                    (RO)
#   Control: /usr/local/bin/oblimint-mail-ctl (docker exec by the panel).
# ─────────────────────────────────────────────────────────────────────────────

ARG ALPINE_IMAGE=alpine:3.21

FROM ${ALPINE_IMAGE}
ARG VERSION=dev

LABEL org.opencontainers.image.title="oblimint-mail-postfix" \
      org.opencontainers.image.description="Oblimint mail engine: Postfix + Dovecot (configuration generated by the panel), mail network only" \
      org.opencontainers.image.source="https://github.com/obli-tools/Oblimint" \
      org.opencontainers.image.version="${VERSION}"

COPY mail-postfix/oblimint-mail-entrypoint mail-postfix/oblimint-mail-ctl /usr/local/bin/
COPY mail-postfix/dovecot.conf /usr/share/oblimint-mail/dovecot.conf
COPY mail-postfix/tests/ /usr/share/oblimint-mail/tests/

# - vmail 5000:5000 (CWP layout; the panel chowns mail/data/postfix-dovecot/vmail to it);
# - Postfix 3.9 / Dovecot 2.3 pinned by branch; lmdb and cidr tables required;
# - /etc/postfix becomes a link to the live compiled generation (tmpfs), the
#   package's meta files (postfix-files, dynamicmaps.cf) move to meta_directory;
# - /etc/dovecot holds only the static include of the live generation;
# - ffdhe2048 DH parameters (Dovecot 2.3 ssl_dh), generated once at build.
RUN set -eux; \
    if getent passwd 5000 || getent group 5000; then echo "uid/gid 5000 already taken in the base image" >&2; exit 1; fi; \
    addgroup -S -g 5000 vmail; \
    adduser -S -D -H -u 5000 -G vmail -h /var/vmail -s /sbin/nologin vmail; \
    apk add --no-cache tini openssl ca-certificates coreutils \
        'postfix~3.9' 'postfix-pcre~3.9' \
        'dovecot~2.3.21' 'dovecot-lmtpd~2.3.21' 'dovecot-pop3d~2.3.21' dovecot-pigeonhole-plugin; \
    postconf -m | grep -qx lmdb || apk add --no-cache 'postfix-lmdb~3.9'; \
    postconf -m | grep -qx lmdb; \
    postconf -m | grep -qx cidr; \
    command -v sievec; command -v doveadm; test -x /usr/libexec/dovecot/quota-status || find / -name quota-status -type f | grep -q .; \
    id postfix; id dovecot; id dovenull; getent group postdrop; \
    mv --version | head -n 1 | grep -q GNU; \
    mkdir -p /usr/share/oblimint-mail /etc/oblimint/mail /etc/oblimint/mail-certs /var/vmail /var/lib/oblimint-mail; \
    mv /etc/postfix /usr/share/oblimint-mail/postfix-meta; \
    test -f /usr/share/oblimint-mail/postfix-meta/postfix-files; \
    ln -s /run/oblimint-mail/live/postfix /etc/postfix; \
    rm -rf /etc/dovecot; mkdir /etc/dovecot; \
    cp /usr/share/oblimint-mail/dovecot.conf /etc/dovecot/dovecot.conf; \
    openssl genpkey -genparam -algorithm DH -pkeyopt dh_param:ffdhe2048 -out /usr/share/oblimint-mail/dh.pem; \
    chmod 0644 /usr/share/oblimint-mail/dh.pem /etc/dovecot/dovecot.conf; \
    chmod 0755 /usr/local/bin/oblimint-mail-entrypoint /usr/local/bin/oblimint-mail-ctl; \
    postconf -d mail_version; dovecot --version; \
    rm -rf /var/cache/apk/*

# Build-time proof that THIS Postfix / Dovecot / Pigeonhole accept what the
# panel renders: tests/fixture is the output of the panel's renderer for a
# realistic state (kept in sync by server/src/services/mail/engines/
# postfixDovecot/fixture.test.ts). It is compiled exactly as at run time
# (postmap, postmap -F, sievec, postconf, doveconf, postfix check), then a few
# security properties are read back from the compiled tables; nothing of it
# stays in the image.
RUN set -eux; \
    cp -R /usr/share/oblimint-mail/tests/fixture/. /etc/oblimint/mail/; \
    for n in mail.oblimint.test mail.exemple.fr; do \
        mkdir -p "/etc/oblimint/mail-certs/$n"; \
        openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj "/CN=$n" \
            -keyout "/etc/oblimint/mail-certs/$n/privkey.pem" -out "/etc/oblimint/mail-certs/$n/fullchain.pem" 2>/dev/null; \
    done; \
    mkdir -p /run/oblimint-mail/selfsigned /run/dovecot; \
    /usr/local/bin/oblimint-mail-ctl compile; \
    test "$(postmap -q info@exemple.fr lmdb:/etc/postfix/maps/virtual_aliases)" = contact@exemple.fr; \
    test "$(postmap -q exemple.fr lmdb:/etc/postfix/maps/virtual_domains)" = OK; \
    if postmap -q pending.fr lmdb:/etc/postfix/maps/virtual_domains; then echo "inactive domain served" >&2; exit 1; fi; \
    postmap -q mail.exemple.fr lmdb:/etc/postfix/sni/tls_sni >/dev/null; \
    test "$(postconf -h smtpd_sasl_auth_enable)" = no; \
    test "$(postconf -h mynetworks)" = '127.0.0.1/32 [::1]/128'; \
    postconf -P | grep -qx '25/inet/smtpd_sasl_auth_enable = no'; \
    postconf -P | grep -qx '587/inet/smtpd_tls_security_level = encrypt'; \
    postconf -P | grep -qx '465/inet/smtpd_tls_wrappermode = yes'; \
    postconf -h oblimint_submission_sender_restrictions | grep -q reject_sender_login_mismatch; \
    doveconf -n >/dev/null; \
    test "$(doveconf -h disable_plaintext_auth)" = yes; \
    test "$(doveconf -h ssl)" = required; \
    : 'Sieve vacation / redirect: SMTP to the loopback-only listener (sendmail -> postdrop cannot write maildrop under no-new-privileges)'; \
    test "$(doveconf -h submission_host)" = 127.0.0.1:10026; \
    postconf -M 127.0.0.1:10026/inet | grep -q '^127\.0\.0\.1:10026 *inet .* smtpd'; \
    postconf -P | grep -qx '127.0.0.1:10026/inet/smtpd_recipient_restrictions = $oblimint_sieve_recipient_restrictions'; \
    test "$(postconf -h oblimint_sieve_recipient_restrictions)" = 'check_recipient_access lmdb:$config_directory/maps/recipient_access, permit_mynetworks, reject'; \
    postconf -P | grep -qx '127.0.0.1:10026/inet/mynetworks = 127.0.0.1/32'; \
    test -s /run/oblimint-mail/live/sieve/104.svbin; \
    : 'userdb extra fields reach the user (Dovecot 2.3 ignores unprefixed passwd-file extra fields as userdb fields: userdb_ prefix)'; \
    dovecot; \
    test "$(doveadm user -f quota_rule contact@exemple.fr)" = '*:storage=1024M'; \
    test "$(doveadm user -f sieve_before vacances@exemple.fr)" = /run/oblimint-mail/live/sieve/104.sieve; \
    doveadm stop; \
    first="$(readlink /run/oblimint-mail/live)"; \
    /usr/local/bin/oblimint-mail-ctl compile; \
    second="$(readlink /run/oblimint-mail/live)"; \
    test "$second" != "$first"; test -d "$second/postfix"; \
    if [ -d "$first" ] && ls -A "$first" | grep -q live; then echo "live switch descended into the old generation" >&2; exit 1; fi; \
    if ls -A /run/oblimint-mail | grep -q '^\.live\.'; then echo "temporary live link left over" >&2; exit 1; fi; \
    /usr/local/bin/oblimint-mail-ctl queue 5 Abc123def456; test -f /var/lib/oblimint-mail/ctl/queue-Abc123def456.jsonl; \
    /usr/local/bin/oblimint-mail-ctl queue 5; test -f /var/lib/oblimint-mail/ctl/queue.jsonl; \
    if /usr/local/bin/oblimint-mail-ctl queue 5 ../x; then echo "invalid nonce accepted" >&2; exit 1; fi; \
    if ls -A /var/lib/oblimint-mail/ctl | grep -q '^\.tmp\.'; then echo "temporary ctl output left over" >&2; exit 1; fi; \
    : 'fresh /run (container start / restart): no live generation yet, the static dovecot.conf cannot be read'; \
    rm -rf /run/oblimint-mail; mkdir -p /run/oblimint-mail/selfsigned; \
    if doveconf -n >/dev/null 2>&1; then echo "static dovecot.conf readable without live: this check proves nothing" >&2; exit 1; fi; \
    /usr/local/bin/oblimint-mail-ctl compile; test -s /run/oblimint-mail/live/sieve/104.svbin; \
    sh -n /usr/local/bin/oblimint-mail-ctl; sh -n /usr/local/bin/oblimint-mail-entrypoint; \
    rm -rf /etc/oblimint/mail/* /etc/oblimint/mail-certs/* /run/oblimint-mail /run/dovecot /var/spool/postfix/* /var/lib/oblimint-mail/* /var/lib/postfix/* 2>/dev/null || true; \
    rm -rf /usr/share/oblimint-mail/tests

WORKDIR /var/lib/oblimint-mail
EXPOSE 25/tcp 465/tcp 587/tcp 143/tcp 993/tcp 110/tcp 995/tcp 4190/tcp
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["/usr/local/bin/oblimint-mail-ctl", "ping"]
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/oblimint-mail-entrypoint"]
CMD []
