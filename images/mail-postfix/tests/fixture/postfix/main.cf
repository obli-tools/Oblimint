# Generated by Oblimint (postfix-dovecot) — Postfix main.cf. Do not edit: rewritten at every sync.
compatibility_level = 3.6
myhostname = mail.oblimint.test
mydomain = mail.oblimint.test
myorigin = $myhostname
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no
recipient_delimiter = +

# No local delivery: every hosted address is virtual (Dovecot LMTP).
mydestination =
local_recipient_maps =
local_transport = error:5.1.1 local delivery is disabled
alias_maps =
alias_database =
relay_domains =
relayhost =
inet_interfaces = all
inet_protocols = all
# MA2: only the container itself is a "trusted network" — never a subnet.
mynetworks = 127.0.0.1/32 [::1]/128

# Container layout (images/mail-postfix): queue and state on the data volume, logs on stdout.
meta_directory = /usr/share/oblimint-mail/postfix-meta
queue_directory = /var/spool/postfix
data_directory = /var/lib/oblimint-mail/postfix
maillog_file = /dev/stdout

message_size_limit = 52428800
mailbox_size_limit = 0
virtual_mailbox_limit = 0

virtual_mailbox_domains = lmdb:$config_directory/maps/virtual_domains
virtual_mailbox_maps = lmdb:$config_directory/maps/virtual_mailboxes
virtual_alias_maps = lmdb:$config_directory/maps/virtual_aliases
virtual_transport = lmtp:unix:private/dovecot-lmtp

# SASL through Dovecot; disabled globally, enabled on 587 / 465 only (master.cf). MA1: never on 25.
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous, noplaintext
smtpd_sasl_tls_security_options = noanonymous
smtpd_sasl_authenticated_header = no
broken_sasl_auth_clients = no
smtpd_sender_login_maps = lmdb:$config_directory/maps/sender_login_maps

smtpd_helo_required = yes
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
smtpd_delay_reject = yes
smtpd_client_connection_rate_limit = 60
smtpd_client_auth_rate_limit = 30
smtpd_client_restrictions =
smtpd_helo_restrictions =
smtpd_sender_restrictions = reject_non_fqdn_sender, reject_unknown_sender_domain
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, check_recipient_access lmdb:$config_directory/maps/recipient_access, permit_mynetworks, reject_unauth_destination, check_policy_service inet:127.0.0.1:12340
smtpd_data_restrictions = reject_unauth_pipelining

# Submission (587 / 465), referenced from master.cf.
oblimint_submission_client_restrictions = permit_sasl_authenticated, reject
# MA3: the null sender (MAIL FROM:<>) skips reject_sender_login_mismatch: refused first on submission.
oblimint_submission_sender_restrictions = reject_non_fqdn_sender, check_sender_access inline:{ { <> = REJECT 5.7.1 A sender address is required for authenticated submission } }, reject_sender_login_mismatch, check_sasl_access lmdb:$config_directory/maps/sasl_access, check_sender_access lmdb:$config_directory/maps/sender_access, permit_sasl_authenticated, reject
oblimint_submission_relay_restrictions = permit_sasl_authenticated, reject
oblimint_submission_recipient_restrictions = reject_non_fqdn_recipient, check_recipient_access lmdb:$config_directory/maps/recipient_access, permit_sasl_authenticated, reject
# Site relay intake (10025): exact relay addresses only, everything else refused (MA2).
oblimint_relay_client_restrictions = check_client_access cidr:$config_directory/cidr/relay_clients, reject
oblimint_relay_sender_restrictions = check_sender_access lmdb:$config_directory/maps/sender_access, reject_non_fqdn_sender
oblimint_relay_relay_restrictions = check_client_access cidr:$config_directory/cidr/relay_clients, reject
oblimint_relay_recipient_restrictions = reject_non_fqdn_recipient, check_recipient_access lmdb:$config_directory/maps/recipient_access, check_client_access cidr:$config_directory/cidr/relay_clients, reject
# Sieve submission (127.0.0.1:10026, vacation / redirect from Dovecot LMTP): loopback clients only.
oblimint_sieve_recipient_restrictions = check_recipient_access lmdb:$config_directory/maps/recipient_access, permit_mynetworks, reject

# TLS: certificates copied by the panel (mail/certs), SNI table, TLS >= 1.2.
smtpd_tls_chain_files = /etc/oblimint/mail-certs/mail.oblimint.test/privkey.pem, /etc/oblimint/mail-certs/mail.oblimint.test/fullchain.pem
tls_server_sni_maps = lmdb:$config_directory/sni/tls_sni
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
smtpd_tls_session_cache_database = lmdb:${data_directory}/smtpd_scache
smtp_tls_security_level = may
smtp_tls_loglevel = 1
smtp_tls_session_cache_database = lmdb:${data_directory}/smtp_scache

# Rspamd (MA14): spam / virus / SPF / DKIM / DMARC in, DKIM signing out.
smtpd_milters = inet:oblimint-mail-rspamd:11332
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = tempfail
milter_connect_timeout = 10s
milter_content_timeout = 120s
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
