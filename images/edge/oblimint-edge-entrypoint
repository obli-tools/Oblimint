#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# oblimint-edge entrypoint: prepares the tmpfs mounts, generates the default
# self-signed certificate (served by the default 443 server, never a real
# site), picks the configuration to start on and runs nginx in the foreground
# as PID 1 (nginx handles signals; STOPSIGNAL SIGQUIT = graceful stop).
#
# ED4 (docs/P4b-PLAN.md §8.6): the edge never depends on the panel to serve.
#   1. live configuration (/etc/nginx/nginx.conf) if `nginx -t` passes;
#   2. else the last good copy written by the panel (base/good.conf, reading
#      /etc/nginx/oblimint/good/, complete when its marker exists);
#   3. else the image defaults only (base/minimal.conf: ACME + 404).
# The master runs with -c /run/oblimint-edge/active.conf, a one-line file
# including the chosen configuration; the panel's next successful apply
# switches it back to the live one (oblimint-edge-reload).
# ─────────────────────────────────────────────────────────────────────────────
set -eu

log() {
	printf '%s oblimint-edge: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

RUN_DIR=/run/oblimint-edge
ACTIVE="$RUN_DIR/active.conf"
LIVE=/etc/nginx/nginx.conf
GOOD=/etc/nginx/oblimint-base/good.conf
GOOD_MARKER=/etc/nginx/oblimint/good/.oblimint-good
MINIMAL=/etc/nginx/oblimint-base/minimal.conf

umask 077
mkdir -p "$RUN_DIR" /var/cache/nginx

if [ ! -s "$RUN_DIR/default.crt" ] || [ ! -s "$RUN_DIR/default.key" ]; then
	openssl req -x509 -nodes -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
		-days 3650 -subj "/CN=oblimint-default" \
		-keyout "$RUN_DIR/default.key" -out "$RUN_DIR/default.crt" 2>/dev/null ||
		{ log "cannot generate the default certificate"; exit 1; }
	chmod 0600 "$RUN_DIR/default.key"
	chmod 0644 "$RUN_DIR/default.crt"
	log "default self-signed certificate generated"
fi

conf="$LIVE"
if ! out=$(nginx -t -c "$LIVE" 2>&1); then
	log "LIVE CONFIGURATION REJECTED by nginx -t: $out"
	if [ -f "$GOOD_MARKER" ] && good_out=$(nginx -t -c "$GOOD" 2>&1); then
		conf="$GOOD"
		log "STARTING ON THE LAST GOOD CONFIGURATION (/etc/nginx/oblimint/good): the panel re-applies the live one at its next sync"
	else
		[ -f "$GOOD_MARKER" ] && log "last good configuration rejected too: ${good_out:-}"
		[ -f "$GOOD_MARKER" ] || log "no last good configuration recorded yet"
		conf="$MINIMAL"
		log "STARTING ON THE IMAGE DEFAULTS ONLY (ACME + 404): the panel re-applies its configuration at its next sync"
	fi
fi

umask 022
printf 'include %s;\n' "$conf" >"$ACTIVE.tmp"
mv -f "$ACTIVE.tmp" "$ACTIVE"

exec nginx -c "$ACTIVE" -g 'daemon off;'
