#
# Generated by siteconf from {{.ConfigFile}} — DO NOT EDIT.
# Site {{.SiteID}}, role {{.Role}}, base {{.Base}} — virtual host of OpenLiteSpeed.
#
{{- if .Placeholder}}

# ── PLACEHOLDER MODE ─────────────────────────────────────────────────────────
# {{.Docroot}} does not exist yet (no release published): every request
# answers 503 + Retry-After with the built-in page. PHP is never used.
docRoot                     {{lsv .ShareDir}}/empty/
enableGzip                  1

accesslog /tmp/lsws/logs/access.log {
    useServer               0
    rollingSize             0
    logReferer              1
    logUserAgent            1
}

errorPage 503 {
    url                     /__oblimint/placeholder.html
}

rewrite {
    enable                  1
    autoLoadHtaccess        0
    rules                   <<<END_rules
RewriteCond %{REQUEST_URI} !^/__oblimint/
RewriteRule ^ - [R=503,L]
END_rules
}

context exp:^/__oblimint/ping$ {
    location                {{lsv .ShareDir}}/ping
    allowBrowse             1
    forceType               text/plain
    rewrite {
        enable              0
    }
}

context exp:^/__oblimint/placeholder\.html$ {
    location                {{lsv .ShareDir}}/placeholder.html
    allowBrowse             1
    extraHeaders            <<<END_extraHeaders
Retry-After: 30
Cache-Control: no-store
END_extraHeaders
    rewrite {
        enable              0
    }
}
{{- else}}

# Release (read-only mount). .htaccess files: OpenLiteSpeed reads their
# REWRITE rules only (at the first request of a directory, again after each
# graceful restart — every publication / rollback reloads).
docRoot                     {{lsv .LsDocRoot}}/
enableGzip                  1

# Access log of the site (a FIFO copied to the container's stdout).
accesslog /tmp/lsws/logs/access.log {
    useServer               0
    rollingSize             0
    logReferer              1
    logUserAgent            1
}

index {
    useServer               0
    indexFiles              {{if .PHP}}index.php, {{end}}index.html, index.htm
    autoIndex               0
}

# Platform 404 page for the 404s OpenLiteSpeed produces itself (missing file);
# the 404 pages of the application (PHP) pass. (ErrorDocument of .htaccess
# files is not read by OpenLiteSpeed.)
errorPage 404 {
    url                     /__oblimint/404.html
}

rewrite {
    enable                  1
    autoLoadHtaccess        1
}

# ── Built-in pages (ping, 404) ──────────────────────────────────────────────
context exp:^/__oblimint/ping$ {
    location                {{lsv .ShareDir}}/ping
    allowBrowse             1
    forceType               text/plain
    rewrite {
        enable              0
    }
}

context exp:^/__oblimint/(404\.html)$ {
    location                {{lsv .ShareDir}}/$1
    allowBrowse             1
    rewrite {
        enable              0
    }
}
{{range .LsGlobal}}
# {{.Comment}}
context {{lsv .URI}} {
    allowBrowse             0
}
{{end}}
# ── Data paths: writable by PHP, NEVER executed, no .htaccess read ───────────
# Root regex contexts: matched before OpenLiteSpeed walks the directories, so
# a .htaccess written by PHP under /srv/data is never loaded.
{{- range .LsData}}

# {{.Comment}}
{{- range .Contexts}}
context {{lsv .URI}} {
{{- if .Location}}
    location                {{lsv .Location}}
{{- end}}
    allowBrowse             {{if .Allow}}1{{else}}0{{end}}
{{- if .NoRewrite}}
    rewrite {
        enable              0
    }
{{- end}}
}
{{- end}}
{{- end}}
{{- end}}
