# ─────────────────────────────────────────────────────────────────────────────
# Generated by siteconf from {{.ConfigFile}} — DO NOT EDIT (re-rendered by
# oblimint-entrypoint / oblimint-reload). Site {{.SiteID}}, role {{.Role}}, base {{.Base}}.
#
# Runs as an arbitrary non-root uid on a read-only root filesystem: pid and
# temp files live under {{.Out}} and {{.TempDir}} (tmpfs); logs go to stdout/stderr.
# ─────────────────────────────────────────────────────────────────────────────

worker_processes 2;
pid {{ns (join .Out "nginx.pid")}};
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
    include {{ns .MimeTypes}};
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    client_max_body_size {{.ClientMaxBodyMb}}m;

    client_body_temp_path {{ns (join .TempDir "client_body")}};
    proxy_temp_path {{ns (join .TempDir "proxy")}};
    fastcgi_temp_path {{ns (join .TempDir "fastcgi")}};
    uwsgi_temp_path {{ns (join .TempDir "uwsgi")}};
    scgi_temp_path {{ns (join .TempDir "scgi")}};

    log_format oblimint '$remote_addr - [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent" $request_time';
    access_log /dev/stdout oblimint;

    # The edge (oblimint-edge) and the panel reach the site over the private
    # account network: trust their X-Forwarded-For / X-Forwarded-Proto.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    map $http_x_forwarded_proto $oblimint_https {
        default "";
        https on;
    }
    map $http_x_forwarded_proto $oblimint_port {
        default 80;
        https 443;
    }

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml;

    server {
        listen 8080 default_server;
        server_name _;
        # Redirects keep the client's host and never expose :8080.
        absolute_redirect off;
        port_in_redirect off;

        location = /__oblimint/ping {
            access_log off;
            default_type text/plain;
            return 200 "ok";
        }
{{- if .Placeholder}}

        # ── PLACEHOLDER MODE ─────────────────────────────────────────────────
        # {{.Docroot}} does not exist yet (no release published): every
        # request answers 503 + Retry-After with the built-in page. PHP is never used.
        error_page 503 /__oblimint/placeholder.html;
        location = /__oblimint/placeholder.html {
            internal;
            default_type text/html;
            alias {{ns (print .ShareDir "/placeholder.html")}};
            add_header Retry-After 30 always;
            add_header Cache-Control "no-store" always;
        }
        location / {
            return 503;
        }
    }
}
{{- else}}

        root {{ns .NginxRoot}};
        index {{if .PHP}}index.php {{end}}index.html index.htm;

        # Hidden files (.git, .env, .htaccess…) are never served.
        location ~ /\.(?!well-known/) {
            return 404;
        }
{{range .DataPaths}}{{if .URLPrefix}}
        # Data path {{.Path}} ({{.Policy}}{{if .Typed}}: {{if .Extensions}}{{joinExt .Extensions ", "}}{{else}}nothing served{{end}}{{end}}) — never executed.
        location ^~ {{ns .URLPrefix}} {
            location ~* \.(php[0-9]?|phar|phtml|pht|phps)(/|$) {
                return 403;
            }
            location ~ /\. {
                return 404;
            }
{{- if .Typed}}
{{- if .Extensions}}
            location ~* \.({{joinExt .Extensions "|"}})$ {
            }
{{- end}}
            return 403;
{{- end}}
        }
{{- else}}
        # Data path {{.Path}} ({{.Policy}}): outside the docroot, not web-reachable.
{{- end}}
{{end}}
{{- if .CustomIncluded}}
        # Site owner's custom rules (validated by siteconf, then `nginx -t`).
        include {{ns (join .Out "custom.conf")}};
{{end}}
{{- if .AppLocationOverridden}}
        # location {{.BasePath}} is defined by the custom rules.
{{- else}}
        location {{ns .BasePath}} {
            try_files $uri $uri/ {{if .PHP}}{{ns .BasePath}}index.php?$query_string{{else}}=404{{end}};
        }
{{- end}}
{{- if and (ne .BasePath "/") (not .RootLocationOverridden)}}
        location / {
            return 404;
        }
{{- end}}
{{- if .PHP}}

        location ~ [^/]\.php(/|$) {
            fastcgi_split_path_info ^(.+?\.php)(/.*)$;
            set $oblimint_path_info $fastcgi_path_info;
            try_files $fastcgi_script_name =404;
            fastcgi_pass unix:{{ns .FpmSocket}};
            fastcgi_index index.php;
            fastcgi_read_timeout {{.Timeout}}s;
            fastcgi_param QUERY_STRING $query_string;
            fastcgi_param REQUEST_METHOD $request_method;
            fastcgi_param CONTENT_TYPE $content_type;
            fastcgi_param CONTENT_LENGTH $content_length;
            fastcgi_param SCRIPT_NAME $fastcgi_script_name;
            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $oblimint_path_info;
            fastcgi_param REQUEST_URI $request_uri;
            fastcgi_param DOCUMENT_URI $document_uri;
            fastcgi_param DOCUMENT_ROOT $realpath_root;
            fastcgi_param SERVER_PROTOCOL $server_protocol;
            fastcgi_param REQUEST_SCHEME $scheme;
            fastcgi_param HTTPS $oblimint_https if_not_empty;
            fastcgi_param GATEWAY_INTERFACE CGI/1.1;
            fastcgi_param SERVER_SOFTWARE nginx;
            fastcgi_param REMOTE_ADDR $remote_addr;
            fastcgi_param REMOTE_PORT $remote_port;
            fastcgi_param SERVER_ADDR $server_addr;
            fastcgi_param SERVER_PORT $oblimint_port;
            fastcgi_param SERVER_NAME $host;
            fastcgi_param REDIRECT_STATUS 200;
            fastcgi_param HTTP_PROXY "";
        }

        # Never source-disclose / run PHP variants other than .php (after the
        # PHP location so /index.php/x.phtml PATH_INFO URLs still reach php-fpm).
        location ~* \.(php[0-9]|phar|phtml|pht|phps)(/|$) {
            return 403;
        }
{{- else}}

        # Static base: PHP sources are never served (no interpreter here).
        location ~* \.(php[0-9]?|phar|phtml|pht|phps|inc)(/|$) {
            return 403;
        }
{{- end}}
    }
}
{{- end}}
