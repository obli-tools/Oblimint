; ─────────────────────────────────────────────────────────────────────────────
; Generated by siteconf from {{.ConfigFile}} — DO NOT EDIT (re-rendered by
; oblimint-entrypoint / oblimint-reload; `kill -USR2` re-reads it).
; Site {{.SiteID}}, role {{.Role}}, base {{.Base}}.
;
; Non-root master (no user/group directives), foreground, logs to stderr.
; ─────────────────────────────────────────────────────────────────────────────

[global]
pid = {{join .Out "php-fpm.pid"}}
error_log = /proc/self/fd/2
log_level = notice
daemonize = no

[site]
listen = {{.FpmSocket}}
listen.mode = 0600

pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 30s
pm.max_requests = 500

catch_workers_output = yes
decorate_workers_output = no
clear_env = yes
request_terminate_timeout = {{.Timeout}}s

; Only *.php is ever executed (a .jpg sent to the pool is refused).
security.limit_extensions = .php

; Security — php_admin_value: neither ini_set() nor .user.ini can change these.
; /opt/oblimint/ only holds the guard (auto_prepend_file is subject to open_basedir).
php_admin_value[open_basedir] = /srv/releases/:/srv/data/:/tmp/:/opt/oblimint/
php_admin_value[auto_prepend_file] = {{.GuardFile}}
php_admin_value[session.save_path] = {{.SessionsDir}}
php_admin_value[upload_tmp_dir] = /tmp
php_admin_value[sys_temp_dir] = /tmp
php_admin_flag[allow_url_include] = off

; Site settings (panel « PHP » tab). php_value: the application may raise
; them itself (WordPress raises memory_limit for its admin, for instance).
php_value[memory_limit] = {{.PHPSettings.MemoryLimitMb}}M
php_value[upload_max_filesize] = {{.PHPSettings.UploadMaxFilesizeMb}}M
php_value[post_max_size] = {{.PHPSettings.PostMaxSizeMb}}M
php_value[max_execution_time] = {{.PHPSettings.MaxExecutionTime}}
php_value[max_input_time] = {{.PHPSettings.MaxExecutionTime}}
