#
# Generated by siteconf from {{.ConfigFile}} — DO NOT EDIT (re-rendered by
# oblimint-entrypoint / oblimint-reload, then read by an OpenLiteSpeed graceful
# restart). Site {{.SiteID}}, role {{.Role}}, base {{.Base}}.
#
# OpenLiteSpeed runs as an arbitrary non-root uid on a read-only root
# filesystem: $SERVER_ROOT/conf is a link to {{.Out}}/lsws (tmpfs), its logs,
# tmp and swap directories live under /tmp. user / group below are never
# switched to (no capability): they only satisfy the configuration parser.
# WebAdmin, QUIC (HTTP/3) and the suEXEC helper are never used: lsphp is
# started by the entrypoint (LSAPI, unix socket), never by the server.
#

serverName                  localhost
user                        nobody
group                       nogroup
httpdWorkers                2
autoRestart                 1
inMemBufSize                32M
swappingDir                 /tmp/lshttpd/swap
autoFix503                  1
gracefulRestartTimeout      {{.Timeout}}
mime                        {{lsv .MimeTypes}}
showVersionNumber           0
indexFiles                  {{if .PHP}}index.php, {{end}}index.html, index.htm
disableWebAdmin             1
# Only the edge (oblimint-edge), the panel and the containers of the account
# reach port 8080 (private account network): X-Forwarded-For / X-Forwarded-Proto
# are trusted from any peer, the LAST address of X-Forwarded-For is the client
# (4: the edge appends the address it saw, like mod_remoteip / real_ip_recursive
# take the rightmost one), and %{HTTPS} of the rewrite rules follows the proto.
useIpInProxyHeader          4

# Logs: FIFOs created by the entrypoint and copied to the container's stderr
# (errors, with the lsphp output) / stdout (accesses): OpenLiteSpeed detaches
# its processes from the container's stdio. Never rotated (rollingSize 0).
errorlog /tmp/lsws/logs/error.log {
    logLevel                WARN
    debugLevel              0
    rollingSize             0
    enableStderrLog         0
}

accessLog /tmp/lsws/logs/access.log {
    useServer               0
    rollingSize             0
    logReferer              1
    logUserAgent            1
}

tuning {
    maxConnections          2000
    connTimeout             {{.Timeout}}
    maxKeepAliveReq         1000
    keepAliveTimeout        5
    maxReqURLLen            32768
    maxReqHeaderSize        65536
    maxReqBodySize          {{.ClientMaxBodyMb}}M
    maxDynRespHeaderSize    32768
    enableGzipCompress      1
    enableDynGzipCompress   1
    gzipCompressLevel       6
    compressibleTypes       default
    # Compressed copies of static files: on the cache tmpfs (bounded, noexec,
    # emptied with the page cache at every reload).
    gzipAutoUpdateStatic    1
    gzipCacheDir            {{lsv (join .LSCacheStore "static")}}
    enableBrCompress        0
    quicEnable              0
}

fileAccessControl {
    followSymbolLink        1
    checkSymbolLink         0
    requiredPermissionMask  000
    restrictedPermissionMask 000
}

accessControl {
    allow                   ALL
}
{{if .PHP}}
# lsphp (LSAPI) — started by the entrypoint on this socket (autoStart 0).
extProcessor lsphp {
    type                    lsapi
    address                 uds:/{{lsv .LsphpSocket}}
    maxConns                {{.LsphpChildren}}
    initTimeout             60
    retryTimeout            0
    persistConn             1
    pcKeepAliveTimeout      30
    respBuffer              0
    autoStart               0
    path                    {{lsv .LsphpBin}}
    backlog                 100
    instances               1
}

# Only .php reaches lsphp (other PHP-like names are refused by the vhost).
scriptHandler {
    add                     lsapi:lsphp php
}
{{end}}
virtualHost site {
    vhRoot                  /srv/
    configFile              {{lsv (join .Out "lsws/vhost.conf")}}
    allowSymbolLink         1
    enableScript            {{if .PHP}}1{{else}}0{{end}}
    # Release data paths are links to /srv/data: never restrained to vhRoot.
    restrained              0
    setUIDMode              0
}

listener http {
    address                 *:8080
    secure                  0
    map                     site *
}

# LSCache (built-in cache module), driven by the application through the
# X-LiteSpeed-Cache-Control / X-LiteSpeed-Purge / X-LiteSpeed-Vary headers
# (LSCache plugins of WordPress, PrestaShop, Joomla…): nothing is cached
# unless the application asks for it (enableCache 0). A page the application
# marks "private" (e.g. LSCache plugin, logged-in visitors) is stored per
# visitor: its key holds EVERY cookie of the request (WordPress session
# cookies included) plus the client address — another visitor never gets it
# (checked: two logged-in users from the same address). Public pages vary on
# _lscache_vary, set by the plugin at login.
module cache {
    ls_enabled              {{if .LSCache}}1{{else}}0{{end}}
    checkPrivateCache       1
    checkPublicCache        1
    maxCacheObjSize         {{.LsMaxCacheObj}}
    maxStaleAge             0
    qsCache                 1
    reqCookieCache          1
    respCookieCache         1
    ignoreReqCacheCtrl      1
    ignoreRespCacheCtrl     0
    enableCache             0
    expireInSeconds         3600
    enablePrivateCache      0
    privateExpireInSeconds  1800
    storagePath             {{lsv (join .LSCacheStore "pages")}}
}
