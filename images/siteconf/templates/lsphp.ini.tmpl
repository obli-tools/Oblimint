; ─────────────────────────────────────────────────────────────────────────────
; Generated by siteconf from {{.ConfigFile}} — DO NOT EDIT (re-rendered by
; oblimint-entrypoint / oblimint-reload; read by every new lsphp process).
; Site {{.SiteID}}, role {{.Role}}, base {{.Base}}.
;
; lsphp equivalent of the php-fpm pool of the other bases: loaded from the scan
; directory (PHP_INI_SCAN_DIR, after php.ini and the extension files), hence
; at system level. lsphp reads no .user.ini (LSPHP_ENABLE_USER_INI is never
; set) and OpenLiteSpeed passes no php_value / php_admin_value from .htaccess:
; auto_prepend_file (PHP_INI_PERDIR) and oblimint.exec_dirs (PHP_INI_SYSTEM)
; cannot be changed by the site; open_basedir can only be narrowed by
; ini_set().
; ─────────────────────────────────────────────────────────────────────────────

[PHP]
; Security (php_admin_value of the php-fpm pools).
open_basedir = /srv/releases/:/srv/data/:/tmp/:/opt/oblimint/
auto_prepend_file = {{.GuardFile}}
; oblimint_exec: PHP is only compiled (main script AND include/require) from
; these real-path prefixes — never from /tmp, typed or user-content data paths.
oblimint.exec_dirs = "{{.ExecDirs}}"
session.save_path = {{.SessionsDir}}
upload_tmp_dir = /tmp
sys_temp_dir = /tmp
allow_url_include = Off

; Site settings (panel « PHP » tab): the application may raise them itself.
memory_limit = {{.PHPSettings.MemoryLimitMb}}M
upload_max_filesize = {{.PHPSettings.UploadMaxFilesizeMb}}M
post_max_size = {{.PHPSettings.PostMaxSizeMb}}M
max_execution_time = {{.PHPSettings.MaxExecutionTime}}
max_input_time = {{.PHPSettings.MaxExecutionTime}}
