# images/mail-rspamd — static options.
# local_addrs: loopback only. Postfix hands every message over the mail
# network, and behind Docker's userland proxy public clients come from a
# private gateway address: nothing must be treated as "local" (no skipped
# checks, no DKIM signing of inbound mail). Signing of the site relay is
# explicit (dkim_signing sign_networks, generated by the panel).
local_addrs = ["127.0.0.0/8", "::1"];
