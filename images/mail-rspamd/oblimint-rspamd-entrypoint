#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# oblimint-mail-rspamd entrypoint (tini is PID 1): runs Rspamd in the
# foreground as the image's rspamd user (the container is started with that
# uid:gid, no capability). Waits for the configuration generated by the panel
# (/etc/rspamd/local.d, read-only bind of mail/config/postfix-dovecot/rspamd).
# ─────────────────────────────────────────────────────────────────────────────
set -eu

WAIT_CONFIG_SEC=${OBLIMINT_MAIL_WAIT_CONFIG_SEC:-120}

log() {
	printf '%s oblimint-rspamd: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

[ "$(id -u)" != 0 ] || { log 'refusing to run as root (start the container as the rspamd user)'; exit 1; }
mkdir -p /run/rspamd /var/lib/rspamd

i=0
until [ -s /etc/rspamd/local.d/redis.conf ] && [ -f /etc/rspamd/local.d/oblimint_sendlimits.map ]; do
	i=$((i + 2))
	if [ "$i" -gt "$WAIT_CONFIG_SEC" ]; then
		log 'no configuration generated by the panel in /etc/rspamd/local.d'
		exit 1
	fi
	sleep 2
done

exec rspamd -f -c /etc/rspamd/rspamd.conf
